[
 {
  "id": 1,
  "take": "T01_cold_open",
  "start": 0.0,
  "end": 5.168,
  "speech_s": 4.34,
  "letters": 61,
  "lps": 14.05,
  "text": "An island fortress across the sea. Its king has ten heads, and a stolen queen.",
  "flag": false
 },
 {
  "id": 2,
  "take": "T01_cold_open",
  "start": 5.168,
  "end": 9.427,
  "speech_s": 3.44,
  "letters": 54,
  "lps": 15.72,
  "text": "On the shore, an army of monkeys builds a bridge of floating stones.",
  "flag": false
 },
 {
  "id": 3,
  "take": "T01_cold_open",
  "start": 9.427,
  "end": 12.709,
  "speech_s": 2.57,
  "letters": 38,
  "lps": 14.8,
  "text": "They follow one man. A prince without a kingdom.",
  "flag": false
 },
 {
  "id": 4,
  "take": "T02_ayodhya",
  "start": 0.0,
  "end": 2.954,
  "speech_s": 2.46,
  "letters": 43,
  "lps": 17.51,
  "text": "Years earlier, Rama was heir to the throne of Ayodhya.",
  "flag": false
 },
 {
  "id": 5,
  "take": "T02_ayodhya",
  "start": 2.954,
  "end": 8.496,
  "speech_s": 4.69,
  "letters": 69,
  "lps": 14.71,
  "text": "He won Princess Sita by lifting a bow no other suitor could move, and it snapped in two.",
  "flag": false
 },
 {
  "id": 6,
  "take": "T02_ayodhya",
  "start": 8.496,
  "end": 13.277,
  "speech_s": 3.85,
  "letters": 59,
  "lps": 15.32,
  "text": "But on the eve of his crowning, Queen Kaikeyi called in two old promises.",
  "flag": false
 },
 {
  "id": 7,
  "take": "T02_ayodhya",
  "start": 13.277,
  "end": 17.424,
  "speech_s": 3.41,
  "letters": 55,
  "lps": 16.13,
  "text": "Her son would rule. Rama would live in the forest for fourteen years.",
  "flag": false
 },
 {
  "id": 8,
  "take": "T03_the_forest",
  "start": 0.0,
  "end": 4.428,
  "speech_s": 3.93,
  "letters": 57,
  "lps": 14.51,
  "text": "He went without a word of protest, with Sita and his brother Lakshmana.",
  "flag": false
 },
 {
  "id": 9,
  "take": "T03_the_forest",
  "start": 4.428,
  "end": 7.791,
  "speech_s": 2.53,
  "letters": 39,
  "lps": 15.39,
  "text": "Deep in the forest, a golden deer lured Rama away.",
  "flag": false
 },
 {
  "id": 10,
  "take": "T03_the_forest",
  "start": 7.791,
  "end": 12.365,
  "speech_s": 3.75,
  "letters": 57,
  "lps": 15.19,
  "text": "Ravana came dressed as a holy man, and carried Sita off through the sky.",
  "flag": false
 },
 {
  "id": 11,
  "take": "T03_the_forest",
  "start": 12.365,
  "end": 16.591,
  "speech_s": 3.27,
  "letters": 41,
  "lps": 12.53,
  "text": "An old vulture, Jatayu, flew up to stop him, and fell.",
  "flag": false
 },
 {
  "id": 12,
  "take": "T04_the_search",
  "start": 0.0,
  "end": 5.576,
  "speech_s": 4.9,
  "letters": 76,
  "lps": 15.51,
  "text": "Searching the south, Rama found allies in the monkey king Sugriva and his minister, Hanuman.",
  "flag": false
 },
 {
  "id": 13,
  "take": "T04_the_search",
  "start": 5.576,
  "end": 9.959,
  "speech_s": 3.36,
  "letters": 46,
  "lps": 13.68,
  "text": "Hanuman leapt the sea, found Sita, and left Lanka burning.",
  "flag": false
 },
 {
  "id": 14,
  "take": "T04_the_search",
  "start": 9.959,
  "end": 12.922,
  "speech_s": 2.2,
  "letters": 35,
  "lps": 15.93,
  "text": "Then the army built its bridge. And crossed.",
  "flag": false
 },
 {
  "id": 15,
  "take": "T05_close",
  "start": 0.0,
  "end": 2.799,
  "speech_s": 2.31,
  "letters": 36,
  "lps": 15.6,
  "text": "The war ended with one arrow, and Ravana fell.",
  "flag": false
 },
 {
  "id": 16,
  "take": "T05_close",
  "start": 2.799,
  "end": 7.146,
  "speech_s": 3.53,
  "letters": 49,
  "lps": 13.87,
  "text": "Rama came home to Ayodhya, and the city lit lamps to greet him.",
  "flag": false
 },
 {
  "id": 17,
  "take": "T05_close",
  "start": 7.146,
  "end": 10.932,
  "speech_s": 2.77,
  "letters": 41,
  "lps": 14.83,
  "text": "Every autumn, at Diwali, millions still light them.",
  "flag": false
 },
 {
  "id": 18,
  "take": "T05_close",
  "start": 10.932,
  "end": 15.288,
  "speech_s": 3.69,
  "letters": 52,
  "lps": 14.1,
  "text": "The poet Valmiki told it in about twenty-four thousand verses.",
  "flag": false
 },
 {
  "id": 19,
  "take": "T05_close",
  "start": 15.288,
  "end": 19.017,
  "speech_s": 3.15,
  "letters": 44,
  "lps": 13.98,
  "text": "More than two thousand years on, it is still being told.",
  "flag": false
 }
]